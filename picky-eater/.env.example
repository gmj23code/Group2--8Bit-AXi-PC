# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Restart `npm run dev` after changing it.

# ---- Claude (menu reading) ----
# Required for real menu scans (Demo mode works without it).
# Get a key at https://platform.claude.com/ → API Keys. Used ONLY on the server.
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-sonnet-5-5).
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Supabase (accounts + saved preferences) ----
# Optional: leave blank and the app runs in guest-only mode.
# Supabase dashboard → Project Settings → API (or "Connect").
# The public "anon" key or the newer "publishable" key both work here; it's safe in the
# browser because Row Level Security (supabase/schema.sql) protects the data.
# NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
